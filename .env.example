# Copy to .env (gitignored) at the repository root. The backend reads it at startup;
# variables already set in the environment take precedence.

# ElevenLabs key for the voice routes (/api/tts, /api/stt). Without it they answer 503.
# More voice settings (voice id, models, language hints): packages/voice/.env.example
ELEVENLABS_API_KEY=

# Gemini key for the chat (POST /api/chat). The backend builds the prompt and calls Google
# with this key, so it never reaches the browser. Without it the route answers 503.
GEMINI_API_KEY=
# Optional: models to try in order, comma-separated; the next is used when one is overloaded.
# A name may carry a thinking level after a colon (low, medium, high; minimal on the lite models).
# Default: gemini-3.5-flash-lite,gemini-3.8-flash:low
# GEMINI_MODEL=
# Optional: the stronger model for goals, plans, advice and second tries (same format), or "off"
# to let the fast model answer everything. Default: gemini-3.8-flash:low,gemini-3.5-flash-lite
# GEMINI_STRONG_MODEL=

# Optional overrides
# PORT=8787
# FINANCE_DB=data/out/finance.sqlite
# STATIC_DIR=packages/app/dist
