# Copy to .env (gitignored) at the repository root. The backend reads it at startup;
# variables already set in the environment take precedence.

# ElevenLabs key for the voice routes (/api/tts, /api/stt). Without it they answer 503.
# More voice settings (voice id, models, language hints): packages/voice/.env.example
ELEVENLABS_API_KEY=

# Gemini key for the chat. The backend forwards the app's /gemini calls to Google and adds
# the key there, so it never reaches the browser. Without it the route answers 503.
GEMINI_API_KEY=

# Optional overrides
# PORT=8787
# FINANCE_DB=data/out/finance.sqlite
# STATIC_DIR=packages/app/dist
