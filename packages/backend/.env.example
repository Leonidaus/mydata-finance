# ElevenLabs API key — secret, never commit the real value.
# Create one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Which voice speaks TTS output. Not a secret.
# Browse voices at https://elevenlabs.io/app/voice-library or list them
# with the SDK: client.voices.search()
# Default below is "George", a stock voice from the ElevenLabs docs.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# TTS model. eleven_multilingual_v2 = best Finnish quality and number
# normalization. eleven_flash_v2_5 = ~100ms latency, half price, but set
# apply_text_normalization if you use it for currency amounts.
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2

# STT model. scribe_v3 = batch transcription of recorded clips.
ELEVENLABS_STT_MODEL_ID=scribe_v3

# Default languages (ISO 639-1). Use "fi" for Finnish. Per-request override:
# languageCode in the /api/tts body, ?languageCode=fi on /api/stt.
# Note: eleven_multilingual_v2 ignores the TTS language and infers it from text.
ELEVENLABS_TTS_LANGUAGE_CODE=en
ELEVENLABS_STT_LANGUAGE_CODE=en

# Port for the standalone dev server (npm run dev in packages/backend).
PORT=3001
