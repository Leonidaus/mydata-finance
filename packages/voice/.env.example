# ElevenLabs API key — secret, never commit the real value.
# Create one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Which voice speaks TTS output. Not a secret.
# Browse voices at https://elevenlabs.io/app/voice-library or list them
# with the SDK: client.voices.search()
# Default below is the voice we picked for Finnish output.
ELEVENLABS_VOICE_ID=hxakRxllsjiR8LZPUfMd

# TTS model. eleven_multilingual_v2 = best Finnish quality and number
# normalization. eleven_flash_v2_5 = ~100ms latency, half price; number
# normalization is forced on so currency amounts read correctly.
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2

# STT model. scribe_v3 = batch transcription of recorded clips.
ELEVENLABS_STT_MODEL_ID=scribe_v3

# Language hints (ISO 639-1), e.g. "en" or "fi". Leave unset to let
# ElevenLabs auto-detect the language, which is the default.
# Per-request override: languageCode in the /api/tts body, ?languageCode=fi
# on /api/stt. Note: eleven_multilingual_v2 ignores the TTS language hint
# and always infers the language from the text.
# ELEVENLABS_TTS_LANGUAGE_CODE=
# ELEVENLABS_STT_LANGUAGE_CODE=

# Port for the standalone dev server (npm run dev in packages/voice).
PORT=3001
