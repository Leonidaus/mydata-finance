# Copy to .env.local (not committed) to change where the app gets its data. Restart `npm run dev` afterwards.

# api (default): the backend's /api, for every customer in the database. Needs the backend running.
# fixtures:      the 15 static demo customers with the engine running in the browser. No backend needed.
VITE_DATA_SOURCE=api

# API mode only. Leave empty to call /api on the app's own origin: the Vite dev server forwards it
# to http://localhost:8787 (set API_PROXY_TARGET when starting Vite to forward somewhere else).
# Set it to call the backend directly instead, e.g. http://localhost:8787
VITE_API_BASE=
