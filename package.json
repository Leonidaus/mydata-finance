{
  "name": "mydata-finance",
  "private": true,
  "description": "MyData-style personal finance explorer — Junction 2026, S-Pankki challenge",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev -w @mydata/app --",
    "build": "npm run build -w @mydata/app --",
